# ─────────────────────────────────────────────────────────────────────────────
# AI-Generated Learning Generator — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME="AI Learning Generator"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-use-a-long-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev — no extra setup needed)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_learning

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-flash

# Default provider: openai | google
AI_PROVIDER=openai

# Per-call timeout and retries for provider requests
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# In development/test, use an explicitly labelled mock when no API key is set.
# In production this is ignored — missing keys return a 503 setup error.
MOCK_AI_IN_DEV=true

# ── PDF uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760        # 10 MB
MAX_PDF_PAGES=50
MAX_EXTRACTED_CHARS=20000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
